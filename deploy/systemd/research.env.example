CTSTEG_BIN=/opt/ctsteg/current/venv/bin/ctsteg
CTSTEG_MANIFEST=/srv/ctsteg/inputs/traceability-core-v2.csv
CTSTEG_CONFIG=/opt/ctsteg/current/configs/digital_ad/final_locked_v1.toml
CTSTEG_STABILITY_PROFILE=/srv/ctsteg/inputs/stability-v2.json
CTSTEG_OUTPUT_ROOT=/srv/ctsteg/results
CTSTEG_CACHE_DIR=/srv/ctsteg/cache
CTSTEG_MONITOR_DIR=/srv/ctsteg/monitor
CTSTEG_MONITOR_INTERVAL_SECONDS=5
CTSTEG_RUNTIME_GATE_REPORT=/srv/ctsteg/gates/latest_runtime_gate.json
CTSTEG_WORKERS=0
CTSTEG_RESERVE_CPUS=4
CTSTEG_RESERVE_MEMORY_GIB=12
CTSTEG_WORKER_MEMORY_GIB=3
CTSTEG_MAX_WORKERS=16
CTSTEG_MIN_FREE_DISK_GIB=100
CTSTEG_REQUIRE_PARQUET=1
CTSTEG_PACKAGE_RESULTS=1
# Current Python configs are Haar/proxy engineering controls. Keep this at 1
# for infrastructure validation; final PDFB execution requires an approved
# adapter/config and this value must then be 0.
CTSTEG_ENGINEERING_CONTROL=1
