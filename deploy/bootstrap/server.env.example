# Non-secret, root-owned configuration for scripts/bootstrap_ubuntu_server.sh.
# Copy to /etc/ctsteg-bootstrap.env and replace every REQUIRED_* value.

CTSTEG_REPOSITORY_URL=https://github.com/alirezaabbaszadeh/contourlet-steganography-repro.git
# Reproducible deployment requires the exact 40-character commit, not a branch.
CTSTEG_GIT_REF=REQUIRED_40_CHARACTER_COMMIT_SHA
CTSTEG_ALLOW_FLOATING_GIT_REF=0

CTSTEG_SERVICE_INSTANCE=final
CTSTEG_INSTALL_ROOT=/opt/ctsteg
CTSTEG_DATA_ROOT=/srv/ctsteg
CTSTEG_SERVICE_USER=ctsteg

# Python is managed independently so Ubuntu 22.04's Python 3.10 is not used.
CTSTEG_PYTHON_VERSION=3.12
CTSTEG_UV_VERSION=0.8.22
CTSTEG_RUN_TESTS=1
CTSTEG_RUN_RUNTIME_GATE=1

# MATLAB R2026a supports Ubuntu 22.04 and 24.04. Stage-0 itself needs MATLAB;
# the repository's legacy run_pair.m also uses Image Processing Toolbox.
# Parallel execution of the 64/88 matrix is handled by Python.
CTSTEG_INSTALL_MATLAB=1
CTSTEG_MATLAB_RELEASE=R2026a
CTSTEG_MATLAB_PRODUCTS="MATLAB Image_Processing_Toolbox"
CTSTEG_MATLAB_ROOT=/opt/matlab/R2026a
CTSTEG_MATLAB_NO_GPU=1

# File Exchange requires accepting its own terms. Download submission 8837
# yourself, place the archive on the server, and record its SHA-256.
CTSTEG_INSTALL_CONTOURLET=1
CTSTEG_CONTOURLET_ARCHIVE=/srv/ctsteg/bootstrap/contourlet_toolbox.zip
CTSTEG_CONTOURLET_ARCHIVE_SHA256=REQUIRED_SHA256

# Prefetches the documented USC-SIPI candidates. It does not select or lock
# the final four traceability pairs.
CTSTEG_PREFETCH_USC_SIPI=1

# Monitor may start immediately. Keep the research service disabled until the
# approved PDFB adapter/config, four-row manifest, and stability profile exist.
CTSTEG_ENABLE_MONITOR_SERVICE=1
CTSTEG_ENABLE_RESEARCH_SERVICE=0

# These are the same hard/recommended bounds used in server_preflight.py.
CTSTEG_MIN_CPUS=16
CTSTEG_MIN_MEMORY_GIB=32
CTSTEG_MIN_DISK_GIB=250
CTSTEG_RECOMMENDED_CPUS=32
CTSTEG_RECOMMENDED_MEMORY_GIB=64
CTSTEG_RECOMMENDED_DISK_GIB=500

# Transient network/package operations retry with bounded exponential backoff.
# Permanent configuration, checksum, licensing, and scientific-gate failures
# remain fail-closed and are not retried forever.
CTSTEG_RETRY_ATTEMPTS=8
CTSTEG_RETRY_INITIAL_SECONDS=5
CTSTEG_RETRY_MAX_SECONDS=120
CTSTEG_NETWORK_CHECK_ATTEMPTS=4
CTSTEG_NETWORK_CHECK_BACKOFF_SECONDS=2
CTSTEG_RUNTIME_GATE_ATTEMPTS=3
